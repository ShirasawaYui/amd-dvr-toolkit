  "created": "2026-11-23",
  "note": "仅供 regress / regress-p3 造夹具，不参与运行时；生产清单 2.0.0 无 builds。这是 1.1.0 五代记录的冻结副本（2026-11-23）。",
  "rules": {
    "applies_to": {
      "component": "AMDRSServ.exe (AMD DVR engine, user-mode)",
      "os": "Windows 11 26H2",
      "arch": "x64 (AMD64)",
      "scope_note": "只管理用户态 DVR 引擎；不改内核驱动、不降级整包、不关闭 Windows 安全保护"
    },
    "patches": [
      {
        "id": "classname-length",
        "kind": "fixed_offset",
        "offset": "0x3686B",
        "old_hex": "08 02",
        "new_hex": "00 01",
        "equal_length": true,
        "purpose": "GetClassNameW 类名读取请求 0x208 -> 0x100，修复 998 越界静默失败",
        "scope": "规则默认（四代 26.20.15.02/.07/.12/.16）；补丁点漂移的构建在 build.patch_points 覆盖 offset/old_hex/new_hex，可带 context_pre_hex 做定位唯一性校验"
      },
      {
        "id": "manifest-uiAccess",
        "kind": "unique_marker",
        "old": "uiAccess=\"true\"></requestedExecutionLevel>\r\n",
        "new": "uiAccess=\"false\"></requestedExecutionLevel>\n",
        "equal_length": true,
        "purpose": "补丁破坏签名后 uiAccess=true 会被 Windows 拒启；true->false(+1B) 配 \r\n->\n(-1B) 保长",
        "scope": "全族同构（unique_marker 与偏移无关）；build.patch_points['manifest-uiAccess'].at 仅作定位信息登记"
      }
    ],
