      },
      {
        "name": "rsrc_version_strings",
        "start": "0x27BAE2",
        "end": "0x27BDDB",
        "note": "版本/来源串（含 AMD-Radeon-Driver/drivers:<hash>）"
      },
      {
        "name": "cert_overlay",
        "start": "0x27F000",
        "end": "EOF",
        "note": "Authenticode 签名覆盖区（文件末尾）"
      }
    ],
    "allowed_diff_basis": "由 26.20.15.02/.07/.12/.16 四代六对原件逐字节比对聚类得出；.text 等代码区零差异（代码零改动）",
    "source_verification": {
      "method": "version_string_source_hash + backup_info 交叉核对",
      "pattern": "AMD-Radeon-Driver/drivers:<40hex>",
      "note": "版本串只能支持 L2 候选资格，不能代替对确切原版哈希的批准"
    },
    "rehearsal_gates": [
      "机器架构 == 0x8664",
      "七节区表（off/vsize/va）与不变量一致",
      "补丁点 0x3686B == 08 02（原版形态；patched/fixed 形态不得充当官方原件）",
      "清单标记唯一：MAN_OLD==1 且 MAN_NEW==0",
      "RT_MANIFEST 存在且 XML 可解析",
      "IAT 含 GetClassNameW / EnumWindows / SendMessageTimeoutW",
      "与参照模板的全部字节差异落在 allowed_diff_regions 内",
      "来源可核验（来源哈希命中 backup_info 或签名有效）"
    ],
    "levels": {
      "L1": "完整哈希已批准且状态一致：orig 先试录、fixed 不重复写、patched 不得充当官方原件",
      "L2": "官方来源可核验且通过全部预演门禁的新样本：仅生成候选报告（登记输入/候选完整哈希），未获批准不得写入安装目标",
      "L3": "来源不明、结构实变、定位结果不唯一或预演超范围：只记录阻断理由，零写入"
    },
    "write_policy": {
      "refuse_on": [
        "manifest_missing",
        "manifest_field_missing",
        "state_conflict",
        "unsupported_rule_version",
        "unknown_build_hash"
      ],
      "no_fallback": "清单不可用时所有写操作必须拒绝；禁止回退读旧硬编码表继续写",
      "candidate_not_approval": "候选报告（L2）不构成写入授权；须经审批绑定确切原版哈希后方可试补",
      "approval_states": {
        "approved": "转正式：B 臂 6/6 验收后的终态",
        "candidate": "已登记候选（U05 审批后新增）：可凭审批绑定进入试补，不等于转正式",
        "holdout": "留出测试用",
        "rejected": "拒绝"
      },
      "trial_write_requires": "U05 审批绑定（目标路径+原版与候选终态哈希+规则版本+范围）+ 操作者授权；与 approval=candidate 记录并存才可试补"
    }
  },
